# Copy to .env for local dev. On Vercel, set these in Project Settings ->
# Environment Variables instead — see "Deploying to Vercel" in README.md.

# Port the server listens on (local dev only — Vercel ignores this).
PORT=3000

# All visitors unlock the next puzzle at local midnight in THIS timezone,
# not their own — so everyone gets the same puzzle on the same real-world
# day. Use an IANA name, e.g. America/New_York, Europe/London, UTC.
RELEASE_TIMEZONE=America/New_York

# Comma-separated usernames that get admin rights. Re-checked on every
# request, so changing this and restarting/redeploying takes effect for
# existing accounts too — no need to re-register.
ADMIN_USERNAMES=your_username_here

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change_me_to_a_long_random_string

# --- The following are set automatically and should NOT be entered by
# --- hand — they appear here only so you know what to expect. See
# --- "Deploying to Vercel" in README.md for how they get set.
#
# KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL /
#   UPSTASH_REDIS_REST_TOKEN) — injected automatically once you attach an
#   Upstash Redis database to this project from the Vercel dashboard.
#
# BLOB_READ_WRITE_TOKEN — injected automatically once you attach a Vercel
#   Blob store to this project.
